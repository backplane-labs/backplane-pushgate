{
  "name": "@backplane-labs/pushgate-client",
  "version": "0.0.0",
  "description": "Desktop client of backplane-pushgate: one WebSocket per device, subscriptions per sender key, RFC 8291 decryption",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backplane-labs/backplane-pushgate.git",
    "directory": "client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p . --noEmit",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "packageManager": "yarn@4.18.1"
}
