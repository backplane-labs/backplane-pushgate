{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["src/**", "e2e/**", "!src/gen"]
  },
  "plugins": ["./biome/no-type-assertion.grit", "./biome/no-unknown.grit"],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noVar": "error",
        "noDoubleEquals": "error",
        "noTsIgnore": "error",
        "noConsole": "error",
        "noEvolvingTypes": "error",
        "noImplicitAnyLet": "error",
        "useAwait": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noDefaultExport": "error",
        "noNamespace": "error",
        "noEnum": "error",
        "noParameterAssign": "error",
        "useImportType": "error"
      },
      "complexity": {
        "noBannedTypes": "error"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "performance": {
        "noReExportAll": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error"
      }
    }
  }
}
